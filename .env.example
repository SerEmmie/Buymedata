# ==============================================================================
# BUYMEDATA — ENVIRONMENT VARIABLES & PAYMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BACHS.IO CONFIGURATION (FINANCIAL INFRASTRUCTURE)
# ------------------------------------------------------------------------------
# BACHS_API_KEY: Used server-side for Bachs checkout sessions, cryptographic
# verification, bank NUBAN resolution, and payout transfers.
# Sandbox keys start with "sk_sandbox_"; Live production keys start with "sk_live_".
# Docs: https://docs.bachs.io
# Example: "sk_sandbox_xxxxxxxxxxxxxxxxxxxxxxxx"
BACHS_API_KEY="sk_sandbox_YOUR_BACHS_API_KEY"

# BACHS_WEBHOOK_SECRET: Secret used to verify HMAC-SHA256 signatures on incoming Bachs webhooks
# (Signed via X-Bachs-Signature / X-Bachs-Signature-V2). Defaults to BACHS_API_KEY if not separate.
BACHS_WEBHOOK_SECRET="sk_sandbox_YOUR_BACHS_WEBHOOK_SECRET"

# PAYMENT_MODE: Sets the transaction mode: "test" for Bachs sandbox, "live" for production.
PAYMENT_MODE="test"

# ------------------------------------------------------------------------------
# 2. APPLICATION & HOSTING
# ------------------------------------------------------------------------------
# APP_URL: Host URL of the deployed application (used for self-referential links,
# Paystack redirect callback_url, and webhook event delivery).
APP_URL="https://buymedata.com"

# PORT: Server listening port (defaults to 3000 in AI Studio).
PORT=3000

# ------------------------------------------------------------------------------
# 3. GEMINI AI CONFIGURATION (SERVER-SIDE)
# ------------------------------------------------------------------------------
# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
