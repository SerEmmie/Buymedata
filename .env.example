# ==============================================================================
# BUYMEDATA — ENVIRONMENT VARIABLES & PAYMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PAYSTACK CONFIGURATION (FINANCIAL INFRASTRUCTURE)
# ------------------------------------------------------------------------------
# PAYSTACK_SECRET_KEY: Used server-side for payment initialization, cryptographic
# verification, bank NUBAN resolution, and transfer disbursements.
# Test mode keys start with "sk_test_"; Live production keys start with "sk_live_".
# Example: "sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
PAYSTACK_SECRET_KEY="sk_test_YOUR_PAYSTACK_SECRET_KEY"

# VITE_PAYSTACK_PUBLIC_KEY: Used client-side for Paystack Inline popup checkout.
# Test mode keys start with "pk_test_"; Live production keys start with "pk_live_".
# Example: "pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
VITE_PAYSTACK_PUBLIC_KEY="pk_test_YOUR_PAYSTACK_PUBLIC_KEY"

# PAYMENT_MODE: Sets the transaction mode: "test" for sandbox, "live" for production.
PAYMENT_MODE="test"

# PAYSTACK_WEBHOOK_SECRET: Secret used to verify HMAC SHA512 signatures on incoming webhooks
# (Paystack uses the Secret Key by default to sign webhook requests in x-paystack-signature).
PAYSTACK_WEBHOOK_SECRET="sk_test_YOUR_PAYSTACK_SECRET_KEY"

# ------------------------------------------------------------------------------
# 2. APPLICATION & HOSTING
# ------------------------------------------------------------------------------
# APP_URL: Host URL of the deployed application (used for self-referential links,
# Paystack redirect callback_url, and webhook event delivery).
APP_URL="https://buymedata.com"

# PORT: Server listening port (defaults to 3000 in AI Studio).
PORT=3000

# ------------------------------------------------------------------------------
# 3. GEMINI AI CONFIGURATION (SERVER-SIDE)
# ------------------------------------------------------------------------------
# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
